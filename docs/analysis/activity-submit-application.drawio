        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam componentStyle rectangle\n\ntitle IDEF0: A0 Декомпозиция диаграммасы (Толық түзетілген)\n\n&#39; Басқару ережелері ( Control - Жоғарыдан екі бөлек түседі )\npackage \&quot;Басқару (Control)\&quot; {\n  [ҚР Қонақүй заңнамасы] as C1\n  [Ішкі ережелер мен тарифтер] as C2\n}\n\n&#39; Кіріс ( Input - Сол жақтан кіреді )\npackage \&quot;Кіріс (Input)\&quot; {\n  [Брондау өтінімі] as I1\n  [Қонақ мәліметтері] as I2\n}\n\n&#39; Механизмдер ( Mechanism - Төменнен блоктардың астына тікелей қосылады )\npackage \&quot;Механизм (Mechanism)\&quot; {\n  [Қонақүйді брондау АЖ] as M1\n  [Төлем жүйесі] as M2\n  [Администратор] as M3\n}\n\n&#39; Блоктар (Әр қайсысында ТЕК 1 функция атауы)\ncomponent \&quot;A1: Бөлмелерді іздеу\&quot; as A1\ncomponent \&quot;A2: Өтінімді қалыптастыру\&quot; as A2\ncomponent \&quot;A3: Төлемді өңдеу\&quot; as A3\ncomponent \&quot;A4: Қонақты тіркеу\&quot; as A4\n\n&#39; Шығыстар ( Output - Оң жаққа шығады )\npackage \&quot;Шығыс (Output)\&quot; {\n  [Расталған бронь (Резерв)] as O1\n  [Төлем түбіртегі мен шот] as O2\n  [Қоныстандыру картасы мен кілт] as O3\n}\n\n&#39; Кіріс сызықтары\nI1 -right-&gt; A1\nI2 -right-&gt; A2\n\n&#39; Ішкі ағындар\nA1 -right-&gt; A2 : Таңдалған бөлме\nA2 -right-&gt; A3 : Есептелген шот\nA3 -right-&gt; A4 : Төленген бронь\n\n&#39; Шығыс сызықтары\nA2 -right-&gt; O1\nA3 -right-&gt; O2\nA4 -right-&gt; O3\n\n&#39; Басқару сызықтары\nC1 -down-&gt; A1\nC1 -down-&gt; A4\nC2 -down-&gt; A2\nC2 -down-&gt; A3\n\n&#39; Механизмдер БЛОКТАРДЫҢ АСТЫНА ТІКЕЛЕЙ қосылады\nM1 -up-&gt; A1\nM1 -up-&gt; A2\nM2 -up-&gt; A3\nM3 -up-&gt; A4\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wv9DEuZ9SZWjQr8yBULr-1">
