        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\n\ntitle Class Diagram\n\nclass Person {\n    +name: String\n    +phone: String\n    +login(): Boolean\n}\n\nclass Guest {\n    +email: String\n    +register(): Boolean\n}\n\nclass Admin {\n    +employeeId: String\n    +verifyCheckIn(): Boolean\n}\n\nclass RoomType {\n    +typeName: String\n    +pricePerNight: Float\n    +capacity: int\n}\n\nclass Room {\n    +roomNumber: String\n    +status: String\n    +updateStatus(status: String): void\n}\n\nclass Reservation {\n    +reservationId: int\n    +checkInDate: Date\n    +checkOutDate: Date\n    +cancel(): Boolean\n}\n\nclass Service {\n    +serviceName: String\n    +cost: Float\n}\n\nclass Invoice {\n    +invoiceId: int\n    +amount: Float\n    +isPaid: Boolean\n    +pay(): Boolean\n}\n\nPerson &lt;|-- Guest\nPerson &lt;|-- Admin\n\n&#39; Ромб бүтін (негізгі) жағында орналасады\nRoomType \&quot;1\&quot; o-- \&quot;*\&quot; Room : агрегация\nGuest \&quot;1\&quot; --- \&quot;*\&quot; Reservation : жасайды\nRoom \&quot;1\&quot; --- \&quot;*\&quot; Reservation : қатысты\nReservation \&quot;1\&quot; *-- \&quot;*\&quot; Service : композиция\nReservation \&quot;1\&quot; --- \&quot;1\&quot; Invoice : генерациялайды\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="NVyleL5v-ITPtW8ooVlW-1">
