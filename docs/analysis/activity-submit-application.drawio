        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Patient\nparticipant \&quot;Web UI\&quot; as UI\nparticipant \&quot;Appointment Service\&quot; as Service\ndatabase \&quot;Database\&quot; as DB\n\nPatient -&gt; UI : selectDoctorAndSlot()\nUI -&gt; Service : createAppointment(doctorId, slot)\nService -&gt; DB : checkSlot(doctorId, slot)\nDB --&gt; Service : slotStatus\n\nalt slot available\n  Service -&gt; DB : saveAppointment()\n  DB --&gt; Service : appointmentId\n  Service -&gt; DB : addEhrRecord(appointmentId)\n  Service -&gt; DB : saveReminder(appointmentId)\n  Service --&gt; UI : appointmentConfirmed\n  UI --&gt; Patient : showConfirmation()\nelse slot not available\n  Service --&gt; UI : slotUnavailable\n  UI --&gt; Patient : showAnotherTimeOption()\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="YUfWwPnz5G2FCKThec9o-1">
